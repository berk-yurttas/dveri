# Dockerfile for environment WITHOUT internet access
FROM python:3.11-bookworm

WORKDIR /app

# Copy requirements first for better caching
COPY dtbackend/requirements.txt .

# Copy ODBC driver packages (must be downloaded separately and placed in offline_packages/)
COPY offline_packages/*.deb /tmp/

# Install system dependencies and Microsoft ODBC Driver 17 from local packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    unixodbc \
    unixodbc-dev \
    && dpkg -i /tmp/msodbcsql17_*.deb || apt-get install -f -y \
    && rm -rf /var/lib/apt/lists/* /tmp/*.deb

# Set ODBC environment variables
ENV ODBCSYSINI=/etc
ENV ODBCINI=/etc/odbc.ini

# Install Python dependencies from company mirror
RUN pip install --no-cache-dir \
    -i http://ftp.company.com.tr/simple/ \
    --index-url http://ftp.company.com.tr/simple/ \
    --trusted-host ftp.company.com.tr \
    -r requirements.txt

# Playwright Chromium (downloaded on a machine with internet via download_playwright_chromium.ps1 / .sh)
COPY offline_packages/ms-playwright /ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Chromium OS libraries (Debian mirror only; does not hit the Playwright CDN)
RUN playwright install-deps chromium || (apt-get update && apt-get install -y --no-install-recommends \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libasound2 libpango-1.0-0 libcairo2 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*)

# Copy application code
COPY dtbackend .

# Expose port
EXPOSE 3000

# Run alembic migrations and then start the application
CMD ["sh", "-c", "alembic upgrade head && alembic -c alembic_romiot.ini upgrade head && uvicorn main:app --host 0.0.0.0 --port 3000 --reload"]
